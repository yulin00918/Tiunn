[{"id":"71","type":"主詞目","raw":"人工","hanji":"人工","lomaji":"lâng-kang","cls":"泛稱,服務業及其他,錢財資產","audio":"71(1)","senses":[{"pos":"名詞","def":"人力、人手。人的勞動力或是指可以工作的人。"},{"pos":"名詞","def":"工資。從事工作所得的報酬。"}]},{"id":"520","type":"主詞目","raw":"才調","hanji":"才調","lomaji":"tsâi-tiāu","cls":"才智能力","audio":"520(1)","senses":[{"pos":"名詞","def":"本事、能力。"}]},{"id":"623","type":"主詞目","raw":"不止仔","hanji":"不止仔","lomaji":"put-tsí-á","cls":"副詞","audio":"623(1)","senses":[{"pos":"副詞","def":"非常、相當的意思。"}]},{"id":"682","type":"主詞目","raw":"中秋","hanji":"中秋","lomaji":"Tiong-tshiu","cls":"時間節令,生活狀況,相關器具、活動","audio":"682(1)","senses":[{"pos":"名詞","def":"中秋節、八月節。我國傳統民俗節日之一。農曆八月十五日，與春節、端午節並列為民間三大傳統節日。通常這天全家會團聚在一起吃月餅、吃柚子、賞月。"}]},{"id":"880","type":"主詞目","raw":"水田","hanji":"水田","lomaji":"tsuí-tshân","cls":"地理,空間方位,農林業","audio":"880(1)","senses":[{"pos":"名詞","def":"種植水稻的田，有蓄水保溫以保護稻苗的功用。"}]},{"id":"922","type":"主詞目","raw":"毋免","hanji":"毋免","lomaji":"m̄-bián","cls":"副詞","audio":"922(1)","senses":[{"pos":"副詞","def":"不必、不用、不需要。"}]},{"id":"1192","type":"主詞目","raw":"水雞","hanji":"水雞","lomaji":"tsuí-ke/tsuí-kue","cls":"爬蟲、兩棲類,生理構造","audio":"1192(1)","senses":[{"pos":"名詞","def":"青蛙。兩棲類動物。腳上有蹼，擅長跳躍、游泳。多生活在水邊，常在夜間活動。"},{"pos":"名詞","def":"女人的生殖器。臺灣南部的「水雞」又指女性的生殖器，為了避諱，便把青蛙叫做「四跤仔」(sì-kha-á)。"}]},{"id":"1758","type":"主詞目","raw":"平常時","hanji":"平常時","lomaji":"pîng-siông-sî","cls":"時間節令","audio":"1758(1)","senses":[{"pos":"時間詞","def":"平時。"}]},{"id":"1918","type":"主詞目","raw":"目屎","hanji":"目屎","lomaji":"ba̍k-sái","cls":"反應、表情","audio":"1918(1)","senses":[{"pos":"名詞","def":"眼淚。"}]},{"id":"2017","type":"主詞目","raw":"田嬰","hanji":"田嬰","lomaji":"tshân-enn/tshân-inn","cls":"昆蟲類","audio":"2017(1)","senses":[{"pos":"名詞","def":"蜻蜓。昆蟲名。身體細長，頭部有一對複眼，胸部和背面有膜質翅兩對。生長在水邊，捕食蚊蠅為生，是一種益蟲。雌蟲用尾部點水把卵產在水中。"}]},{"id":"2894","type":"主詞目","raw":"佗位","hanji":"佗位","lomaji":"tó-uī","cls":"代名詞","audio":"2894(1)","senses":[{"pos":"疑問詞","def":"哪裡。"}]},{"id":"3508","type":"主詞目","raw":"身軀","hanji":"身軀","lomaji":"sin-khu","cls":"生理構造","audio":"3508(1)","senses":[{"pos":"名詞","def":"身體。"}]},{"id":"3553","type":"主詞目","raw":"佳哉","hanji":"佳哉","lomaji":"ka-tsài","cls":"副詞","audio":"3553(1)","senses":[{"pos":"副詞","def":"幸虧、好在。"}]},{"id":"4001","type":"主詞目","raw":"所在","hanji":"所在","lomaji":"sóo-tsāi","cls":"空間方位","audio":"4001(1)","senses":[{"pos":"名詞","def":"地方。"}]},{"id":"4090","type":"主詞目","raw":"放棄","hanji":"放棄","lomaji":"hòng-khì","cls":"一般動詞-行為動詞","audio":"4090(1)","senses":[{"pos":"動詞","def":"拋棄不要。"}]},{"id":"4298","type":"主詞目","raw":"沿路","hanji":"沿路","lomaji":"iân-lōo","cls":"道路、橋梁","audio":"4298(1)","senses":[{"pos":"形容詞","def":"一路上。"}]},{"id":"4384","type":"主詞目","raw":"空地","hanji":"空地","lomaji":"khàng-tē/khàng-tuē","cls":"空間方位,居住環境","audio":"4384(1)","senses":[{"pos":"名詞","def":"沒有加以利用或空無所有的地。"}]},{"id":"4734","type":"主詞目","raw":"勇氣","hanji":"勇氣","lomaji":"ióng-khì","cls":"心理狀態","audio":"4734(1)","senses":[{"pos":"名詞","def":"勇往直前無所畏懼的氣魄。"}]},{"id":"4737","type":"主詞目","raw":"勇健","hanji":"勇健","lomaji":"ióng-kiānn","cls":"醫療保健","audio":"4737(1)","senses":[{"pos":"形容詞","def":"健朗。形容身體健康硬朗。"}]},{"id":"4963","type":"主詞目","raw":"怨嘆","hanji":"怨嘆","lomaji":"uàn-thàn","cls":"心理活動","audio":"4963(1)","senses":[{"pos":"動詞","def":"怨恨悲嘆。"}]},{"id":"5099","type":"主詞目","raw":"查某囡仔","hanji":"查某囡仔","lomaji":"tsa-bóo gín-á","cls":"泛稱","audio":"5099(1)","senses":[{"pos":"名詞","def":"對年輕女子的泛稱。"}]},{"id":"5471","type":"主詞目","raw":"茄苳","hanji":"茄苳","lomaji":"ka-tang","cls":"花草樹木","audio":"5471(1)","senses":[{"pos":"名詞","def":"木本植物。一種半落葉性的喬木，枝幹直立，枝葉開展且茂密，樹皮呈赤褐色，幹面則呈現鱗狀剝落。是臺灣鄉間常見的樹種。"}]},{"id":"5837","type":"主詞目","raw":"厝頂","hanji":"厝頂","lomaji":"tshù-tíng","cls":"建築物、結構","audio":"5837(1)","senses":[{"pos":"名詞","def":"屋頂。"}]},{"id":"6036","type":"主詞目","raw":"時陣","hanji":"時陣","lomaji":"sî-tsūn","cls":"時間節令","audio":"6036(1)","senses":[{"pos":"名詞","def":"時候。"}]},{"id":"6050","type":"主詞目","raw":"時間","hanji":"時間","lomaji":"sî-kan","cls":"時間節令","audio":"6050(1)","senses":[{"pos":"名詞","def":"泛指時刻的長短，單位為秒、分、時、日、月、年等等。"},{"pos":"副詞","def":"一時之間，極短的時間。"}]