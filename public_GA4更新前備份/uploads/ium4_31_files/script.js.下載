function audio_player(str) {
	//console.log(str);
	if (document.getElementById("video_obj")) {
		document.getElementById("video_obj").pause();
	}
	document.getElementById("audio_obj").src = str;
	document.getElementById("audio_obj").play();
}
function video_player(str) {
	//console.log(str);
	$("#video_obj").show();
	document.getElementById("audio_obj").pause();
	document.getElementById("video_obj").src = str;
	document.getElementById("video_obj").play();
}
